{"nodes": [{"id": "app_skills_skill_creator_skill_skill_creator", "label": "skill-creator Skill (cognitive task extension framework)", "file_type": "document", "source_file": "APP/SKILLS/skill-creator/SKILL.md", "source_location": "L1-L38", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_skills_skill_creator_skill_event_struct", "label": "Trial Event Schema (trialIndex, timestamp, eventType, latency)", "file_type": "concept", "source_file": "APP/SKILLS/skill-creator/SKILL.md", "source_location": "L12-L16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_skills_skill_creator_skill_input_capture_standard", "label": "Standardised High-Precision Input Capture Pattern", "file_type": "rationale", "source_file": "APP/SKILLS/skill-creator/SKILL.md", "source_location": "L20-L31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every task in the app must timestamp with performance.now() inside a capture-phase, non-passive keydown listener so that latency numbers are comparable across tasks and never contaminated by handler ordering or auto-repeat."}, {"id": "app_skills_skill_creator_skill_storage_backup", "label": "Storage & Backup Convention (participant-keyed localStorage mirror)", "file_type": "rationale", "source_file": "APP/SKILLS/skill-creator/SKILL.md", "source_location": "L33-L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keying the localStorage mirror by participant ID plus timestamp (e.g. nir-pbm-P05-1719246100) keeps runs from overwriting one another and makes traces recoverable after a browser crash or power interruption."}, {"id": "app_skills_skill_creator_skill_programmatic_stimulus_requirement", "label": "Programmatic Stimulus Requirement (Web Audio / SVG, no media files)", "file_type": "rationale", "source_file": "APP/SKILLS/skill-creator/SKILL.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New tasks must generate stimuli programmatically rather than play assets, so scheduling accuracy is bounded by the audio/render clock instead of by asset fetch and decode time."}], "edges": [{"source": "app_skills_skill_creator_skill_skill_creator", "target": "app_skills_skill_creator_skill_event_struct", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/SKILLS/skill-creator/SKILL.md", "source_location": "L12-L16", "weight": 1.0}, {"source": "app_skills_skill_creator_skill_skill_creator", "target": "app_skills_skill_creator_skill_input_capture_standard", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/SKILLS/skill-creator/SKILL.md", "source_location": "L20-L31", "weight": 1.0}, {"source": "app_skills_skill_creator_skill_skill_creator", "target": "app_skills_skill_creator_skill_storage_backup", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/SKILLS/skill-creator/SKILL.md", "source_location": "L33-L38", "weight": 1.0}, {"source": "app_skills_skill_creator_skill_input_capture_standard", "target": "app_skills_frontend_design_skill_timing_precision", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "APP/SKILLS/skill-creator/SKILL.md", "source_location": "L20-L31", "weight": 1.0}, {"source": "app_skills_skill_creator_skill_storage_backup", "target": "app_skills_frontend_design_skill_data_persistence", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "APP/SKILLS/skill-creator/SKILL.md", "source_location": "L33-L38", "weight": 1.0}, {"source": "app_skills_skill_creator_skill_programmatic_stimulus_requirement", "target": "app_skills_frontend_design_skill_audio_stimulus", "relation": "semantically_similar_to", "confidence": "INFERRED",