{"nodes": [{"id": "app_index_experiment_task_page", "label": "Experiment Task Page (index.html)", "file_type": "code", "source_file": "APP/index.html", "source_location": "L1-L196", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_index_researcher_dashboard", "label": "Researcher Dashboard Sidebar (config, live stats, telemetry console)", "file_type": "concept", "source_file": "APP/index.html", "source_location": "L16-L133", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_index_session_configuration", "label": "Session Configuration (participant ID, session ID, pause, randomized sequence)", "file_type": "concept", "source_file": "APP/index.html", "source_location": "L31-L53", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_index_realtime_metrics", "label": "Real-time Statistics Grid (avg latency, false alarms, misses, contact temp)", "file_type": "concept", "source_file": "APP/index.html", "source_location": "L56-L92", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_index_nir_device_link", "label": "NIR Device Link Control (task page drives Arduino stimulation directly)", "file_type": "rationale", "source_file": "APP/index.html", "source_location": "L99-L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The experiment task page owns the serial link to the Arduino so that stimulation start/stop is bound to the same page that schedules trials, avoiding a second operator page and keeping stimulation and behavioural timing on one clock."}, {"id": "app_index_nir_stop_alert", "label": "Stimulation Stop-Reason Alert Banner", "file_type": "rationale", "source_file": "APP/index.html", "source_location": "L137-L140", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the NIR/heater stops mid-session (e.g. thermal cutoff) the researcher must see it immediately without watching the hardware dashboard, since a silently aborted stimulation would invalidate the run."}, {"id": "app_index_blinding_indicator", "label": "Blinding Indicator Shield (minimalist low-luminosity dot)", "file_type": "rationale", "source_file": "APP/index.html", "source_location": "L142-L143", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The study blinding relies on 850 nm NIR being invisible; the participant-facing view must carry no condition-revealing visual cue, so the focus indicator is deliberately low-luminosity and condition-independent."}, {"id": "app_index_live_rt_chart", "label": "Live Reaction-Time Chart (SVG, 0-500 ms gridlines)", "file_type": "concept", "source_file": "APP/index.html", "source_location": "L166-L183", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_index_session_protocol_summary", "label": "Session Protocol Summary (17 min = 10 EMG + 7 reaction-time, 5 s + [0,2 s] jitter, SPACE key)", "file_type": "concept", "source_file": "APP/index.html", "source_location": "L146-L164", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "app_index_experiment_task_page", "target": "app_arduino_hardware_dashboard_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/index.html", "source_location": "L25", "weight": 1.0}, {"source": "app_index_experiment_task_page", "target": "app_io_test_io_diagnostics_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/index.html", "source_location": "L26", "weight": 1.0}, {"source": "app_index_experiment_task_page", "target": "app_index_nir_device_link", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/index.html", "source_location": "L99-L103", "weight": 1.0}, {"source": "app_