{"nodes": [{"id": "app_skills_frontend_design_skill_frontend_design", "label": "frontend-design Skill (Experiment UI design & precision guidelines)", "file_type": "document", "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L1-L36", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_skills_frontend_design_skill_timing_precision", "label": "Timing Precision Guideline (capture-phase keydown + performance.now)", "file_type": "rationale", "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L10-L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "performance.now() is used instead of Date.now() because it is a monotonic high-resolution clock immune to system clock adjustments; capture-phase listening timestamps the press before any bubbling handler runs, event.repeat filters keyboard auto-repeat, and preventDefault stops Space from scrolling the page."}, {"id": "app_skills_frontend_design_skill_audio_stimulus", "label": "Programmatic Audio Stimulus (600 Hz sine, 10 ms attack / 150 ms decay)", "file_type": "rationale", "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L16-L22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tones are synthesised with the Web Audio API rather than loaded as files to avoid file-load and caching latency that would blur stimulus onset; the attack/decay envelope removes clicks that would otherwise act as an extra transient cue, and AudioContext is created on first user gesture to satisfy browser autoplay policy."}, {"id": "app_skills_frontend_design_skill_trial_protocol_logic", "label": "Trial Protocol Logic (40 s trial, 5 s + jitter, false-alarm timer reset)", "file_type": "rationale", "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L24-L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A premature press restarts the 5 s + random delay so participants cannot lock onto a rhythm and pre-empt the tone; the randomised offset makes the stimulus onset unpredictable and keeps reaction times reactive rather than anticipatory."}, {"id": "app_skills_frontend_design_skill_blinding_support", "label": "Blinding-Support UI Rule (plain participant calibration screen)", "file_type": "rationale", "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L33-L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Participants keep their eyes closed during runs, so the participant-facing view is distraction-free and carries no condition information, while all rich status display is confined to the researcher dashboard."}, {"id": "app_skills_frontend_design_skill_data_persistence", "label": "Data Persistence Rule (localStorage mirror + CSV export)", "file_type": "rationale", "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trial results are written to localStorage as they happen so an accidental reload or browser crash cannot destroy an irreplaceable single-session recording; CSV export is the researcher-facing egress."}], "edges": [{"source": "app_skills_frontend_design_skill_frontend_design", "target": "app_skills_frontend_design_skill_timing_precision", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L10-L14", "weight": 1.0}, {"source": "app_skills_frontend_design_skill_frontend_design", "target": "app_skills_frontend_design_skill_audio_stimulus", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L16-L22", "weight": 1.0}, {"source": "app_skills_frontend_design_skill_frontend_design", "target": "app_skills_frontend_design_skill_trial_protocol_logic", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L24-L29", "weight": 1.0}, {"source": "app_skills_frontend_design_skill_frontend_design", "target": "app_skills_frontend_design_skill_data_persistence", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L35", "weight": 1.0}, {"source": "app_skills_frontend_design_skill_frontend_design", "target": "app_index_experiment_task_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L8", "weight": 1.0}, {"source": "app_skills_frontend_design_skill_blinding_support", "target": "app_index_blinding_indicator", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L33", "weight": 1.0}, {"source": "app_skills_frontend_design_skill_data_persistence", "target": "app_index_researcher_dashboard", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L35", "weight": 1.0}, {"source": "app_skills_frontend_design_skill_timing_precision", "target": "app_index_live_rt_chart", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L10-L14", "weight": 1.0}, {"source": "app_skills_frontend_design_skill_trial_protocol_logic", "target": "app_index_session_protocol_summary", "relation": "conceptually_related_to", "confidence": "AMBIGUOUS", "confidence_score": 0.3, "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L25-L29", "weight": 1.0}, {"source": "app_skills_frontend_design_skill_audio_stimulus", "target": "app_index_realtime_metrics", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.65, "source_file": "APP/SKILLS/frontend-design/SKILL.md", "source_location": "L16-L22", "weight": 1.0}], "hyperedges": [{"id": "high_precision_rt_measurement_protocol", "label": "High-precision reaction-time measurement protocol (capture-phase input, synthesised tone, jittered scheduling, persisted log)", "nodes": ["app_skills_frontend_design_skill_timing_precision", "app_skills_frontend_design_skill_audio_stimulus", "app_skills_frontend_design_skill_trial_protocol_logic", "app_skills_skill_creator_skill_input_capture_standard", "app_skills_skill_creator_skill_event_struct", "app_index_experiment_task_page"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "APP/SKILLS/frontend-design/SKILL.md"}]}