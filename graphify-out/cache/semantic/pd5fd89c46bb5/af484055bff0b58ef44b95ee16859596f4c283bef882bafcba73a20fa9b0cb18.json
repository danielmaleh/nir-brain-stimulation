{"nodes": [{"id": "app_arduino_hardware_dashboard_page", "label": "Hardware Dashboard Page (arduino.html)", "file_type": "code", "source_file": "APP/arduino.html", "source_location": "L1-L246", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_arduino_serial_connection_panel", "label": "Web Serial Connection Panel (115200 bps)", "file_type": "concept", "source_file": "APP/arduino.html", "source_location": "L31-L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_arduino_device_command_actions", "label": "Device Action Commands (M cycle, G start, X abort, R reset latch, S simulate over-temp)", "file_type": "concept", "source_file": "APP/arduino.html", "source_location": "L47-L59", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_arduino_temperature_gauge", "label": "DS18B20 Contact Temperature Gauge & 60 s Sparkline", "file_type": "concept", "source_file": "APP/arduino.html", "source_location": "L92-L142", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "app_arduino_heater_pid_control", "label": "Closed-Loop PID Heater Control (NIR-matched target 37.5 \u00b0C)", "file_type": "rationale", "source_file": "APP/arduino.html", "source_location": "L67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The heating-only control condition must reproduce the skin warmth produced by the NIR array so that warmth sensation is not a cue; a PID loop to a calibrated NIR-matched setpoint (default 37.5 \u00b0C) is used instead of fixed duty, and HEATER_PID telemetry lines expose duty/temp/target."}, {"id": "app_arduino_safety_latch_monitor", "label": "Safety Latch & State Monitoring (40.0 \u00b0C cutoff)", "file_type": "rationale", "source_file": "APP/arduino.html", "source_location": "L185-L212", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skin-contact temperature may never exceed 40 \u00b0C; the cutoff is a latching state that must be explicitly reset by the operator (R) rather than auto-clearing, so an over-temperature event cannot be silently ignored."}, {"id": "app_arduino_mode_led_blinding_constraint", "label": "Mode LED Blinding Constraint (mode LEDs off during active stimulation)", "file_type": "rationale", "source_file": "APP/arduino.html", "source_location": "L68", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Indicator LEDs would reveal the active condition to the participant and break blinding, so they are extinguished while stimulation runs and only used for pre-run operator feedback."}, {"id": "app_arduino_serial_data_feed", "label": "Serial Data Feed Console with Telemetry/Controls Filters", "file_type": "concept", "source_file": "APP/arduino.html", "source_location": "L214-L232", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "app_arduino_hardware_dashboard_page", "target": "app_index_experiment_task_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/arduino.html", "source_location": "L24", "weight": 1.0}, {"source": "app_arduino_hardware_dashboard_page", "target": "app_io_test_io_diagnostics_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/arduino.html", "source_location": "L26", "weight": 1.0}, {"source": "app_arduino_hardware_dashboard_page", "target": "app_arduino_device_command_actions", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/arduino.html", "source_location": "L47-L59", "weight": 1.0}, {"source": "app_arduino_hardware_dashboard_page", "target": "app_arduino_temperature_gauge", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "APP/arduino.html", "source_location": "L9